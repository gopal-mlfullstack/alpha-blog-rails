<div class="text-center" >
  <div class="container  border border-secondary text-bg-danger" >
    <% if @article.errors.any? %>
      <h2 class="fs-4 text-decoration-underline" >The following errors prevented the article from being saved</h2>
      <ul class="list-unstyled">
        <% @article.errors.full_messages.each do |msg|%>
        
        <li><%= msg %></li>
        <% end %>
      </ul>  
    <% end %>
  </div>  

  <%= form_with(model: @article, local: true)  do  |f| %>

    <div class="display-6 mt-5" >
      <%= f.label :title%><br>
      <%= f.text_field :title%>
    </div>
    <br>
    <div class="mb-3">
      <%= f.label :description, class: "form-label" %>
      <%= f.text_area :description, class: "form-control", rows: 5, placeholder: "Write your article description..." %>
    </div>
    
    <%= f.submit "create_article", class:"btn btn-secondary"%>
    

  <% end %>

</div>