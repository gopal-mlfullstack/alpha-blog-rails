<div class="container py-5">
  <div class="row text-center ">  
    <h1 class="display-4 text-black mb-5" >Articles listing page</h1>

    <table class="table" >

      <thead>
        <tr>
          <th>Title</th>
          <th>Description</th>
          <th colspan="3" >Actions</th>
        </tr>
      </thead>
      <tbody>
          <% @articles.each do |article| %>
            <tr>
              <td><%= article.title %></td>
              <td><%= article.description %></td>
              <td> <%= link_to "Show", article_path(article), class:"link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover"  %> </td>
              <td> <%= link_to "Edit", edit_article_path(article), class:"link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover"   %> </td>
              <td><%= link_to "Delete", article_path(article), data: {turbo_method: :delete, turbo_confirm: "Are you sure?"}, class:"link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover"   %></td>
            </tr>
          <% end %>  
      </tbody>

    </table>
    <%= link_to "create new article", new_article_path, class: "btn btn-secondary"  %>
  </div>  
</div>
<br>
